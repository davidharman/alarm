#!/bin/zsh
trap ctrl_c INT

# Alarm 
AlarmVersion=0.4
# Author: David Harman
# Date: 26th June 2023
# Script to have a countdown to a particular time and also have a snooze function
# Requires: TermDown
#    

function ctrl_c() {
        echo "** Trapped CTRL-C"
        echo "\aStopped: $(date "+%H:%M:%S")"        
        exit
}
if  test "$1" = "-h" ; then
   echo "Usage: alarm [TIME] [TEXT] [FONT]
  
  Re-uses TermDown to default some options such as voice and font

  Starts a countdown to or from TIME. Example values for TIME:
  10, '1h 5m 30s', '12:00', '2020-01-01', '2020-01-01 14:00 UTC'.

  If TIME is not given, termdown will operate in stopwatch mode
  and count forward.

  TEXT is optional, when used will provide a banner at the top to describe the alarm.

  FONT is optional and if not provided will default to big font, other fonts are starwars, epic, isometric1, basic, doh
  Default for termdown is univers

  More examples here: http://www.figlet.org/examples.html
"
exit
fi

if [ -z "$2" ]; then
   2="Alarm"
fi
fontchoice=$3
if [ -z "$fontchoice" ]; then
   fontchoice="starwars"
fi

# Combine Text and Start Time (used to have a return line in date %n but this caused issues)
textstring="$2$(date "+%H:%M:%S")"

# Echo details of timer to confirm when timer was started, ended or cancelled and what the parameters where
echo "Timer: $1" 
#echo $textstring
textstring2=$2$'\n -- '$1' --'
mycontinue=1
# Current countdown target: starts as the user's TIME, replaced by a clock time on snooze.
# A single termdown call at the top of the loop uses it; running a second termdown for the
# snooze (as v0.2 did) made the loop re-run the original TIME afterwards.
target=$1
# Command to show countdown timer using the parameters with the voice
until [[ $mycontinue -eq 0 ]]
do
#    echo $fontchoice
#    echo $textstring2
    echo $2
    termdown -B -f $fontchoice -v Fiona -T $textstring2 -c 10 $target
	say $2
	displayText=''
	textLength=${#2}
	halfTextLength=$(expr $textLength / 2)
	offSet=$(expr 30 - $halfTextLength)
	#echo $offSet
	displayText=$(eval $(echo printf '" %0.s"' {1..$offSet})) #insert padding
	displayText="$diplayText$displayText$2$displayText"
	# The text is passed to AppleScript as an argument (argv) rather than being pasted into the
	# script source, so quotes/backslashes in TEXT cannot break or inject into the AppleScript.
	# If the dialog is cancelled (Esc) osascript exits non-zero with no output: treat that as Stop,
	# otherwise the empty result would be handled as a snooze with no minutes.
	result=$(osascript \
		-e 'on run argv' \
		-e 'display dialog (item 1 of argv) buttons {"Stop","Snooze"} default answer "2" default button "Snooze" with title "Enter number of minutes to snooze for" with icon caution' \
		-e 'end run' \
		"$displayText" 2>/dev/null) || result="button returned:Stop, text returned:"
	resulttext=${result##*:}
	resultbutton=$(echo ${result:16:4})

	case $resultbutton in
		"Stop")
			mycontinue=0
			;;
		*)
			mycontinue=1
			# Only a whole number of minutes >= 1 is valid; anything else would make date fail
			# and leave termdown with no target (it would then count up forever).
			if [[ $resulttext != <-> ]] || (( resulttext < 1 )); then
				echo "Invalid snooze '$resulttext', using 2 minutes"
				resulttext=2
			fi
			timetype='M'
			timer=$resulttext$timetype
			# Snooze: next loop iteration counts down to this clock time
			target=$(date -v +$timer "+%H:%M:%S")
			textstring2=$2$'\n -- '$target' --'
			;;
	esac
done
# Uncomment this if you want a sound to play as well as the say command
#afplay /System/Library/Sounds/Sosumi.aiff
echo 
# Says the word provided, if no word it says Alarm
#osascript -e 'display alert "'$2'"'
# Shows when the code ended
echo "Ended: $(date "+%H:%M:%S")"
exit
